{
  "name": "atlas-of-one",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "test:browser": "npm run build && vitest run --config vitest.browser.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "art:build": "ART_WORK=${ART_WORK:-.art-src} python3 tools/art/build_assets.py"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "fake-indexeddb": "^6.2.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.33.1"
  }
}
